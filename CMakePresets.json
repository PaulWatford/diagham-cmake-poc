{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default",
      "description": "Every module (core, FQHE, FTI, Spin, QuantumDots), SMP, no optional libraries: the configuration CI tests"
    },
    {
      "name": "core",
      "inherits": "base",
      "displayName": "Core only",
      "description": "Base/src + src only (no physics module)",
      "cacheVariables": {
        "DIAGHAM_BUILD_FQHE": "OFF",
        "DIAGHAM_BUILD_FTI": "OFF",
        "DIAGHAM_BUILD_SPIN": "OFF",
        "DIAGHAM_BUILD_QUANTUMDOTS": "OFF"
      }
    },
    {
      "name": "lapack",
      "inherits": "base",
      "displayName": "LAPACK",
      "description": "Default plus system LAPACK/BLAS (--enable-lapack)",
      "cacheVariables": {
        "DIAGHAM_USE_LAPACK": "ON"
      }
    },
    {
      "name": "full",
      "inherits": "base",
      "displayName": "All serial optional libraries",
      "description": "LAPACK, GSL, GMP, FFTW3 and bzip2 (the common workstation configure line)",
      "cacheVariables": {
        "DIAGHAM_USE_LAPACK": "ON",
        "DIAGHAM_USE_GSL": "ON",
        "DIAGHAM_USE_GMP": "ON",
        "DIAGHAM_USE_FFTW": "ON",
        "DIAGHAM_USE_BZ2": "ON"
      }
    },
    {
      "name": "hpc",
      "inherits": "base",
      "displayName": "HPC cluster (MPI + ScaLAPACK)",
      "description": "MPI, LAPACK, ScaLAPACK, GSL; see docs/how-to/build/hpc-cluster.md",
      "cacheVariables": {
        "DIAGHAM_USE_MPI": "ON",
        "DIAGHAM_USE_LAPACK": "ON",
        "DIAGHAM_USE_SCALAPACK": "ON",
        "DIAGHAM_USE_GSL": "ON"
      }
    },
    {
      "name": "mkl",
      "inherits": "base",
      "displayName": "Intel MKL",
      "description": "LAPACK/BLAS/FFTW3 from Intel MKL (--enable-intelmkl)",
      "cacheVariables": {
        "DIAGHAM_USE_LAPACK": "ON",
        "DIAGHAM_USE_MKL": "ON",
        "DIAGHAM_USE_FFTW": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "description": "Default modules, CMake Debug (-g, no optimisation); upstream --enable-debug is RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "core",    "configurePreset": "core" },
    { "name": "lapack",  "configurePreset": "lapack" },
    { "name": "full",    "configurePreset": "full" },
    { "name": "hpc",     "configurePreset": "hpc" },
    { "name": "mkl",     "configurePreset": "mkl" },
    { "name": "debug",   "configurePreset": "debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "default", "inherits": "base", "configurePreset": "default" },
    { "name": "core",    "inherits": "base", "configurePreset": "core" },
    { "name": "lapack",  "inherits": "base", "configurePreset": "lapack" },
    { "name": "full",    "inherits": "base", "configurePreset": "full" },
    { "name": "hpc",     "inherits": "base", "configurePreset": "hpc" },
    { "name": "mkl",     "inherits": "base", "configurePreset": "mkl" },
    { "name": "debug",   "inherits": "base", "configurePreset": "debug" },
    {
      "name": "physics",
      "inherits": "base",
      "configurePreset": "default",
      "description": "Only the physics goldens (skips the per-program --help smoke tests)",
      "filter": { "include": { "label": "physics" } }
    }
  ]
}
